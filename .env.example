# Sanity — copia in .env e compila i valori
# Crea il progetto su https://www.sanity.io/manage

PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Token di lettura (per build Astro) — opzionale su dataset pubblico
SANITY_API_READ_TOKEN=

# Token Editor (solo per npm run seed) — da sanity.io/manage → API → Tokens
SANITY_API_WRITE_TOKEN=
