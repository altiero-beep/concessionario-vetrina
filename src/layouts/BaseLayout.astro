---
import { getDealer } from "../lib/dealer";

interface Props {
  title: string;
  description: string;
  current?: "home" | "parco-auto" | "contatti";
}

const { title, description, current } = Astro.props;
const dealer = await getDealer();
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a href="/" class="logo">
          <span class="logo__name">{dealer.nome}</span>
          <span class="logo__tagline">{dealer.tagline}</span>
        </a>
        <button class="menu-toggle" type="button" aria-label="Apri menu" id="menu-toggle">Menu</button>
        <nav class="nav" id="main-nav">
          <a href="/" class:list={["nav__link", { "is-active": current === "home" }]}>Home</a>
          <a href="/parco-auto/" class:list={["nav__link", { "is-active": current === "parco-auto" }]}>Parco auto</a>
          <a href="/#noleggio" class="nav__link">Noleggio</a>
          <a href="/contatti/" class:list={["nav__link", { "is-active": current === "contatti" }]}>Contatti</a>
          <a href="/contatti/" class="btn btn--primary nav__cta">Richiedi info</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <p class="site-footer__copy">
          © {year} {dealer.nome}. Tutti i diritti riservati.
        </p>
        <div class="site-footer__links">
          <a href="/parco-auto/">Parco auto</a>
          <a href="/#noleggio">Noleggio</a>
          <a href="/contatti/">Contatti</a>
          <a href="/privacy/">Privacy</a>
          <a href="/termini/">Termini</a>
          <a href={`tel:${dealer.telefono}`}>{dealer.telefonoDisplay}</a>
        </div>
      </div>
    </footer>

    <script>
      document.getElementById("menu-toggle")?.addEventListener("click", () => {
        document.getElementById("main-nav")?.classList.toggle("is-open");
      });
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
